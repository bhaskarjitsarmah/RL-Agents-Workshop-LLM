# Copy this file to ".env" and fill in what you need. See SETUP.md.
#
# This repo needs FEWER keys than RL-Agents-Workshop, because the policy runs
# locally on your GPU and the reward is a local SQLite query -- there is no API
# call in the training loop at all. Only W&B is genuinely required, and even
# that has an offline mode.

# ============================================================================
# 1. Weights & Biases -- REQUIRED for training runs. https://wandb.ai/authorize
#    This is where the GRPO curves live; reading them is half of NB3.
# ============================================================================
WANDB_API_KEY=...
# No account / no network? Curves still get written locally:
# WANDB_MODE=offline

# ============================================================================
# 2. OpenAI -- OPTIONAL. Only for the gpt-4o-mini comparison rows in NB0/NB8
#    and for generating the frozen paraphrase set. Without it, those rows are
#    read from data/baseline_test.json (repo 1's published result) instead.
# ============================================================================
# OPENAI_API_KEY=sk-your-key-here

# Point at any OpenAI-compatible endpoint. NB5 and NB7 set this at runtime to
# an ART-served / self-hosted vLLM endpoint and then re-run the SAME evaluate().
# OPENAI_BASE_URL=https://api.openai.com/v1

# The model used for the comparison rows. Must match repo 1 to keep the
# head-to-head honest -- repo 1's published 0.75 was measured on gpt-4o-mini.
WORKSHOP_MODEL=gpt-4o-mini

# ============================================================================
# 3. Hugging Face -- OPTIONAL. The pre-baked adapters are PUBLIC, so you only
#    need a token to push your OWN adapters. https://huggingface.co/settings/tokens
# ============================================================================
# HF_TOKEN=hf_...
# HF_NAMESPACE=bhaskarjitsarmah

# ============================================================================
# 4. Langfuse -- OPTIONAL tracing. llm.py falls back to plain `openai` cleanly
#    if these are absent or the package isn't installed.
# ============================================================================
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# ============================================================================
# 5. Workshop knobs
# ============================================================================
# The policy under training. Drop to 0.5B on a throttled runtime -- every
# training run roughly halves, and the pre-baked 0.5B adapters exist too.
MODEL_SIZE=1.5B
