# Line endings are part of the fairness contract here.
#
# tests/test_vendored_parity.py asserts the sha256 of llm_utils/db.py,
# tasks.py, and evaluate.py. If git rewrote LF -> CRLF on checkout (the Windows
# default with core.autocrlf=true), those hashes would change and the test would
# fail on a fresh clone for a reason that has nothing to do with parity.
#
# So: LF everywhere, in the repo AND in the working tree, on every platform.
* text=auto eol=lf

# Belt and braces for the hash-asserted files.
llm_utils/db.py        text eol=lf
llm_utils/tasks.py     text eol=lf
llm_utils/evaluate.py  text eol=lf
llm_utils/agents.py    text eol=lf
data/baseline_test.json text eol=lf

# Generated task sets and pre-baked results: checked in, never converted.
data/*.jsonl           text eol=lf
data/results/*.json    text eol=lf

# Notebooks are generated by build_notebooks.py; keep diffs honest.
*.ipynb                text eol=lf

# Binary
*.png   binary
*.db    binary
*.safetensors binary
*.gguf  binary
